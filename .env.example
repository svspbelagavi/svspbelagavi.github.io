# ──────────────────────────────────────────────────────────────────────────
# SVSP — Environment variables (TEMPLATE)
# Copy this file to `.env.local` (NEVER commit `.env.local`).
# In CI/CD, set these as GitHub Actions secrets.
# ──────────────────────────────────────────────────────────────────────────

# Firebase client config (rotate any key that has ever been committed!)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=svsp-admin.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=svsp-admin
VITE_FIREBASE_STORAGE_BUCKET=svsp-admin.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=325758257923
VITE_FIREBASE_APP_ID=

# Google Apps Script URL — handles contact + newsletter form submissions
VITE_SCRIPT_URL=
